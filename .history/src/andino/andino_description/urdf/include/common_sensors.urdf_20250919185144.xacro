<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


<xacro:macro name="laser" params="prefix parent_link sensor_prop">

  <xacro:property name="mesh"
     value="${sensor_prop['laser']['mesh']}"/>

  <link name="${prefix}_laser_link">
    <xacro:if value="${mesh != '' }" >
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="package://andino_description/meshes/sensors/${mesh}" />
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </xacro:if>
  <xacro:if value="${mesh == '' }" >
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <cylinder radius="${sensor_prop['laser']['radius']}" length="${sensor_prop['laser']['length']}"/>
      </geometry>
      <material name="red"/>
    </visual>
  </xacro:if>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${sensor_prop['laser']['radius']}" length="${sensor_prop['laser']['length']}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${sensor_prop['laser']['mass']}"
                            r="${sensor_prop['laser']['radius']}"
                            l="${sensor_prop['laser']['length']}"
                            o_xyz="0 0 0"
                            o_rpy="0 0 0" />
  </link>

  <joint name="${prefix}_laser_joint" type="fixed">
    <parent link="${parent_link}"/>
    <child link="${prefix}_laser_link"/>
    <origin xyz="${sensor_prop['laser']['dx']} ${sensor_prop['laser']['dy']} ${sensor_prop['laser']['dz']}" rpy="0 0 ${pi}"/>
    <axis xyz="0 1 0" />
  </joint>


</xacro:macro>

<xacro:macro name="camera_sensor" params="parent_link sensor_prop">
  <xacro:property name="mesh"
     value="${sensor_prop['camera']['mesh']}"/>
     
  <link name="camera_link">
    <!-- Visual -->
    <xacro:if value="${mesh != '' }">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://andino_description/meshes/sensors/${mesh}" />
        </geometry>
        <material name="blue"/>
      </visual>
    </xacro:if>
    <xacro:if value="${mesh == '' }">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sensor_prop['camera']['box_size']} ${sensor_prop['camera']['box_size']} ${sensor_prop['camera']['box_size']}"/>
        </geometry>
        <material name="blue"/>
      </visual>
    </xacro:if>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${sensor_prop['camera']['box_size']} ${sensor_prop['camera']['box_size']} ${sensor_prop['camera']['box_size']}"/>
      </geometry>
    </collision>

    <!-- Inertia -->
    <xacro:box_inertia m="${sensor_prop['camera']['mass']}"
                       x="${sensor_prop['camera']['box_size']}"
                       y="${sensor_prop['camera']['box_size']}"
                       z="${sensor_prop['camera']['box_size']}"
                       o_xyz="0 0 0"
                       o_rpy="0 0 0" />

    <!-- Gazebo Camera Plugin -->
    <gazebo>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <robotNamespace>/camera_front</robotNamespace>
        <cameraName>camera_front</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <frameName>camera_link</frameName>
        <updateRate>30.0</updateRate>
        <alwaysOn>true</alwaysOn>
      </plugin>
    </gazebo>

  </link>

  <!-- Joint -->
  <joint name="camera_joint" type="fixed">
    <parent link="${parent_link}"/>
    <child link="camera_link"/>
    <origin xyz="${sensor_prop['camera']['dx']} ${sensor_prop['camera']['dy']} ${sensor_prop['camera']['dz']}" rpy="0 0 0"/>
    <axis xyz="0 1 0" />
  </joint>



</xacro:macro>
<xacro:macro name="imu_sensor" params="parent_link sensor_prop">
   <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.0025"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.01 0.0025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1e-5" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="${parent_link}"/>
    <child link="imu_link"/>
    <origin xyz="${sensor_prop['imu']['dx']} ${sensor_prop['imu']['dy']} ${sensor_prop['imu']['dz']}" rpy="0 0 0"/>
    <axis xyz="0 1 0" />
  </joint>
  <gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>/imu/data</topic> <!-- Use a fully qualified topic name -->
  </sensor>
</gazebo>
  </xacro:macro>
<xacro:macro name="ultrasonic_sensor" params="parent_link sensor_prop">
  <link name="${sensor_prop}_link">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.01"/>
      </geometry>
      <material>
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <gazebo>
    <sensor type="ray" name="${sensor_prop}_sensor">
      <update_rate>30</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>10</samples>
            <resolution>1</resolution>
            <min_angle>-0.2</min_angle>
            <max_angle>0.2</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>2.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="${sensor_prop}_controller" filename="libgazebo_ros_range.so">
        <ros>
          <namespace>/andino</namespace>
          <remapping>
            <remap from="~/out" to="/${sensor_prop}/scan"/>
          </remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Fixed joint -->
  <joint name="${sensor_prop}_joint" type="fixed">
    <parent link="${parent_link}"/>
    <child link="${sensor_prop}_link"/>
  </joint>
</xacro:macro>



</robot>
