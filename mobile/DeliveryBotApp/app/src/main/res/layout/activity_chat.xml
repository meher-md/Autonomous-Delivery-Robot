<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- العنوان -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Open Chat &amp; Control"
        android:textStyle="bold"
        android:textSize="22sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- صندوق الرسائل -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/inputRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/chatLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#DDDDDD"
            android:padding="8dp"/>
    </ScrollView>

    <!-- إدخال/إرسال -->
    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/connectRow">

        <EditText
            android:id="@+id/inputMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type message" />

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- صف الاتصال (IDs مطلوبة: btnConnect) -->
    <LinearLayout
        android:id="@+id/connectRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/togglePanelBtn"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ws://&lt;ROS_IP&gt;:9090" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- زر إظهار/إخفاء لوحة التحكم -->
    <Button
        android:id="@+id/togglePanelBtn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Control Panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/controlPanel"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- لوحة الأسهم داخل قسم Open Chat -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center_horizontal"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ↑ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">
            <Button
                android:id="@+id/btnUp"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:text="↑"/>
        </LinearLayout>

        <!-- ← ■ → -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btnLeft"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:text="←"
                android:layout_marginEnd="8dp"/>
            <Button
                android:id="@+id/btnStop"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:text="■"
                android:layout_marginEnd="8dp"/>
            <Button
                android:id="@+id/btnRight"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:text="→"/>
        </LinearLayout>

        <!-- ↓ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btnDown"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:text="↓"/>
        </LinearLayout>

        <!-- السرعة + سلايدر speedBar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btnSpeedPlus"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="+ Speed"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed: 0.2"
                android:textSize="16sp"
                android:layout_marginEnd="12dp"/>
            <Button
                android:id="@+id/btnSpeedMinus"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:text="- Speed"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/speedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="20" />

        <TextView
            android:id="@+id/bridgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="rosbridge: DISCONNECTED"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
